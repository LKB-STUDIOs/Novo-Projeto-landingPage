# Copie este arquivo para ".env" e preencha. Sem estas duas linhas a plataforma abre em MODO DEMONSTRAÇÃO.
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública ("anon" / "publishable"). Pode ficar no site: quem protege os dados são as regras do banco (supabase/schema.sql).
# NUNCA coloque aqui a chave "service_role" ou "secret".
VITE_SUPABASE_ANON_KEY=
