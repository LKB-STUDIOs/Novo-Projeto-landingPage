# Copie este arquivo para ".env" (sem o .example) e preencha.
# O .env fica só no seu PC: nunca envie ele para o GitHub nem por mensagem.

# ── Banco do MyLogical (os mesmos dados da tela "Bancos de Dados" do MyLogical)
# IP do servidor, igual ao campo "IP / Porta" da tela do MyLogical (ex.: 10.0.0.5)
FB_HOST=
FB_PORT=3050
# Nome do banco. Pode ser o apelido (MyLogical) ou o caminho completo no servidor,
# por exemplo C:\MyLogical\Dados\MYLOGICAL.FDB
FB_DATABASE=MyLogical
FB_USER=SYSDBA
FB_PASSWORD=
# Conjunto de caracteres. Se acentos aparecerem errados ou der erro
# "Cannot transliterate", troque para WIN1252 (ou NONE).
FB_CHARSET=UTF8

# ── App
# Porta onde o app abre (no PC: http://localhost:8080)
PORT=8080
# Senha/PIN para entrar no app (no PC e no celular). Mínimo 4 caracteres.
APP_PIN=
# Permite gravar no banco do MyLogical (sim/nao).
# Deixe "nao" até testar e ter um backup do banco.
ALLOW_WRITE=nao

# ── HTTPS opcional (necessário para instalar como app de verdade no celular)
# Coloque cert.pem e key.pem na pasta certs/ (veja o LEIA-ME) e ele liga sozinho.
HTTPS_PORT=8443
